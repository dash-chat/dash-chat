{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ES2020",
		"moduleResolution": "node",
		"esModuleInterop": true,
		"skipLibCheck": true,
		"strict": true,
		"allowJs": true,
		"types": [
			"@wdio/mocha-framework",
			"node",
			"webdriverio",
			"expect-webdriverio"
		],
		"outDir": "dist"
	},
	"include": [
		"specs/**/*.ts",
		"setup/**/*.ts",
		"helpers/**/*.ts",
		"wdio.conf.ts",
		"compat/wdio.compat.ts",
		"globals.d.ts"
	]
}
