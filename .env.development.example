# Copy to .env.development (gitignored; the justfile loads it for every recipe).

# Wi-Fi networks the e2e fuzz may walk phones and hubs through, as
# ssid:passphrase pairs in the order the moves index them. Leave unset to keep
# every hub and network move out of the runs. Each access point must:
#   - serve DHCP on a subnet of its own (two on the RouterOS default
#     192.168.88.0/24 hand out clashing routes);
#   - use WPA2-PSK, or no security (a bare `ssid` with no passphrase);
#   - need no upstream — a phone on it has no internet, which is the point.
# Neither SSID nor passphrase may contain ':' or ','. The host's Wi-Fi card
# joins these for the length of a networked run; everything else rides its
# wired link.
E2E_WIFI_NETWORKS=dash-lab-a:passphraseA,dash-lab-b:passphraseB
