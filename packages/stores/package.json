{
	"name": "dash-chat-stores",
	"version": "0.0.1",
	"type": "module",
	"description": "",
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"scripts": {
		"build": "rimraf dist && tsc && babel ./src --extensions \".ts\" --out-dir ./dist",
		"dev": "concurrently -k \"tsc -w --preserveWatchOutput\" \"babel --watch ./src --extensions \".ts\" --out-dir ./dist\"",
		"format": "prettier --write 'src/**/*.ts'",
		"check": "tsc --noEmit && prettier --check 'src/**/*.ts'"
	},
	"dependencies": {
		"@tauri-apps/api": "^2",
		"@webbuf/blake3": "^3.0.28",
		"blakejs": "^1.2.1",
		"emittery": "^1.2.0",
		"rimraf": "^6.1.0",
		"signalium": "^3.0.1",
		"tauri-plugin-system-theme": "github:dash-chat/tauri-plugin-system-theme#27d004e3f97ad088a9a2fcdc4a03bd45825265dd",
		"webbuf": "^3.0.28"
	},
	"devDependencies": {
		"@babel/cli": "^7.28.3",
		"@babel/preset-typescript": "^7.28.5",
		"@types/node": "^24.10.0",
		"concurrently": "^9.2.1",
		"typescript": "^5.9.3"
	}
}
