{
	"name": "i18n-screenshots",
	"version": "0.0.1",
	"type": "module",
	"description": "Screenshots of an app for translators, each with the keys of the strings it shows",
	"exports": {
		"./markers": "./src/markers.ts",
		"./capture": "./src/capture.ts"
	},
	"scripts": {
		"format": "prettier --write 'src/**/*.ts'",
		"check": "tsc --noEmit && prettier --check 'src/**/*.ts'"
	},
	"peerDependencies": {
		"playwright-core": "^1.65.1"
	},
	"peerDependenciesMeta": {
		"playwright-core": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/node": "^24.10.0",
		"playwright-core": "^1.65.1",
		"typescript": "^5.9.3"
	}
}
