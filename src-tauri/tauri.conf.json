{
	"productName": "Dash Chat",
	"version": "0.10.0",
	"identifier": "studio.darksoil.dashchat",
	"build": {
		"beforeBuildCommand": "pnpm -F dash-chat-stores build && pnpm -F ui build",
		"devUrl": "http://localhost:1420",
		"frontendDist": "../ui/build"
	},
	"app": {
		"windows": [
			{
				"title": "Dash Chat",
				"width": 800,
				"height": 600
			}
		],
		"withGlobalTauri": true,
		"security": {
			"capabilities": [
				"mobile-capability",
				"main-capability",
				"desktop-capability"
			]
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"macOS": {
			"entitlements": "entitlements.plist"
		},
		"createUpdaterArtifacts": true
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE3RUU3OTAxOUYzN0M2RkEKUldUNnhqZWZBWG51RitCWXhZdFY4RHVhQzY0bVgxU0tnc0JBSm9pSmliZ2pBUGRvOWFlbWV6b24K",
			"endpoints": [
				"https://github.com/darksoil-studio/dash-chat/releases/latest/download/latest.json"
			]
		},
		"deep-link": {
			"mobile": [{ "scheme": ["dash-chat"] }],
			"desktop": {
				"schemes": ["dash-chat"]
			}
		}
	}
}
