# Sourced by the `Build Rust Code` phases before they run `pnpm tauri ios
# xcode-script`. pnpm 11 defaults verify-deps-before-run to `install`, so that
# nested pnpm auto-runs `pnpm install`, which decides node_modules must be
# recreated from scratch and then fails on the confirmation prompt (no TTY
# under xcodebuild, and CI=true no longer skips it).
export pnpm_config_verify_deps_before_run=false

# Without DWARF the uploaded dSYM resolves Rust crash frames to function names
# at best, never file and line. The DWARF lands only in the dSYM: the linked app
# binary carries none. Scoped to iOS; the Android release job dropped it.
export CARGO_PROFILE_RELEASE_DEBUG=line-tables-only
