{
	"$schema": "../gen/schemas/mobile-schema.json",
	"identifier": "ios-capability",
	"windows": ["main"],
	"platforms": ["iOS"],
	"permissions": [
		"ios-photos:default",
		"fs:allow-temp-read-recursive",
		{
			"identifier": "fs:allow-remove",
			"allow": [{ "path": "$TEMP/*.jpg" }]
		},
		"mcp-bridge:default"
	]
}
