{
	"identifier": "desktop-capability",
	"platforms": ["macOS", "windows", "linux"],
	"windows": ["main"],
	"permissions": [
		"core:default",
		"process:default",
		"updater:default",
		"mcp-bridge:default",
		"dialog:allow-save",
		"fs:allow-write-file",
		"fs:allow-read-file",
		{
			"identifier": "fs:scope",
			"allow": [{ "path": "**" }]
		}
	]
}
