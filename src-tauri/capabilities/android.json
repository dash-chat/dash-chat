{
	"$schema": "../gen/schemas/android-schema.json",
	"identifier": "android-capability",
	"windows": ["main"],
	"platforms": ["android"],
	"permissions": [
		"android-fs:allow-create-new-public-image-file",
		"android-fs:allow-write-file",
		"android-fs:allow-read-file",
		"android-fs:allow-get-thumbnail-as-data-url",
		{
			"identifier": "medialibrary:global-scope",
			"allow": [{ "source": "ExternalStorage" }, { "source": "VolumeExternalPrimary" }]
		},
		"medialibrary:allow-get-images",
		"medialibrary:allow-request-permissions"
	]
}
