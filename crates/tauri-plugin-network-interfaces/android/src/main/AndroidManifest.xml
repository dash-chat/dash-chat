<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Held while the app is in the foreground so the wifi driver stops
         discarding multicast that is not addressed to this device. Every mDNS
         reply arrives on 224.0.0.251, so without this a hub that starts while
         we are already browsing is never heard. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

</manifest>
